package components

type DropdownOption struct {
	Value    string
	Label    string
	Selected bool
}

func getSelectedValue(options []DropdownOption) string {
	for _, opt := range options {
		if opt.Selected {
			return opt.Value
		}
	}
	if len(options) > 0 {
		return options[0].Value
	}
	return ""
}

func getSelectedLabel(options []DropdownOption, placeholder string) string {
	for _, opt := range options {
		if opt.Selected {
			return opt.Label
		}
	}
	if len(options) > 0 {
		return options[0].Label
	}
	return placeholder
}

script toggleDropdownScript(id string) {
	toggleCustomDropdown(id);
}

script selectOptionScript(id string, value string, label string) {
	selectCustomDropdownOption(id, value, label);
}

templ CustomDropdown(id string, name string, options []DropdownOption, placeholder string) {
	<div class="custom-dropdown-wrapper position-relative" id={ id + "-wrapper" }>
		<input type="hidden" id={ id } name={ name } value={ getSelectedValue(options) } />
		<div class="form-select custom-dropdown-trigger font-monospace cursor-pointer d-flex justify-content-between align-items-center py-2 px-3 border rounded bg-white" 
		     onclick={ toggleDropdownScript(id) }
		     style="cursor: pointer; user-select: none;">
			<span id={ id + "-label" }>{ getSelectedLabel(options, placeholder) }</span>
		</div>
		<div class="custom-dropdown-options position-absolute w-100 bg-white border rounded shadow-sm mt-1 d-none" 
		     style="z-index: 1050; max-height: 250px; overflow-y: auto;" 
		     id={ id + "-options" }>
			for _, opt := range options {
				<div class="custom-dropdown-option p-2 cursor-pointer font-monospace select-item" 
				     data-value={ opt.Value } 
				     onclick={ selectOptionScript(id, opt.Value, opt.Label) }
				     style="font-size: 13px; cursor: pointer; border-bottom: 1px solid #f8f9fa;">
					{ opt.Label }
				</div>
			}
		</div>
	</div>
}

templ DropdownScript() {
	<script>
		function toggleCustomDropdown(id) {
			const options = document.getElementById(id + "-options");
			if (options) {
				document.querySelectorAll('.custom-dropdown-options').forEach(el => {
					if (el.id !== id + "-options") {
						el.classList.add("d-none");
					}
				});
				options.classList.toggle("d-none");
			}
		}

		function selectCustomDropdownOption(id, value, label) {
			const hiddenInput = document.getElementById(id);
			const triggerLabel = document.getElementById(id + "-label");
			const options = document.getElementById(id + "-options");
			
			if (hiddenInput && triggerLabel && options) {
				hiddenInput.value = value;
				triggerLabel.textContent = label;
				options.classList.add("d-none");
				
				hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
			}
		}

		document.addEventListener('click', function(e) {
			if (!e.target.closest('.custom-dropdown-wrapper')) {
				document.querySelectorAll('.custom-dropdown-options').forEach(el => el.classList.add('d-none'));
			}
		});
	</script>
}
