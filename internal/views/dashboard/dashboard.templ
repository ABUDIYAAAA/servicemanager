package dashboard

import (
	"servicemanager/internal/models"
	"servicemanager/internal/views/layouts"
	viewsUsers "servicemanager/internal/views/users"
	viewsServices "servicemanager/internal/views/services"
)

templ Dashboard(
	currentUser models.User,
	usersList []models.User,
	invites []models.Invite,
	servicesList []models.Service,
	githubRepos []models.GithubRepo,
	installations []models.GithubInstallation,
	githubAuthURL string,
	inviteError string,
	serviceError string,
) {
	@layouts.Layout("Dashboard") {
		<!-- Header -->
		<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
			<div>
				<h1 class="h3 mb-0">Service Manager</h1>
				<p class="text-muted mb-0">Logged in as: <strong>{ currentUser.Email }</strong> (<span class="badge bg-primary">{ string(currentUser.UserRole) }</span>)</p>
			</div>
			<div>
				<form method="POST" action="/logout">
					<button type="submit" class="btn btn-outline-danger">Logout</button>
				</form>
			</div>
		</div>

		<!-- Nav Tabs -->
		<ul class="nav nav-tabs" id="dashboardTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="services-tab" data-bs-toggle="tab" data-bs-target="#services" type="button" role="tab" aria-controls="services" aria-selected="true">Services</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab" aria-controls="users" aria-selected="false">Users</button>
			</li>
			if currentUser.UserRole == models.RoleAdmin {
				<li class="nav-item" role="presentation">
					<button class="nav-link" id="system-logs-tab" data-bs-toggle="tab" data-bs-target="#system-logs" type="button" role="tab" aria-controls="system-logs" aria-selected="false">System Logs</button>
				</li>
			}
		</ul>

		<!-- Tab Content -->
		<div class="tab-content" id="dashboardTabsContent">
			<!-- Services Tab -->
			<div class="tab-pane fade show active" id="services" role="tabpanel" aria-labelledby="services-tab">
				<div class="row pt-3">
					<!-- Left: Add Service Form (Admins only) -->
					if currentUser.UserRole == models.RoleAdmin {
						<div class="col-md-4">
							if serviceError != "" {
								<div class="alert alert-danger">{ serviceError }</div>
							}
							@viewsServices.AddServiceForm(githubRepos, installations, githubAuthURL)
						</div>
						<div class="col-md-8">
							<div class="card shadow-sm">
								<div class="card-body">
									<h5 class="card-title mb-3">Configured Services</h5>
									<div id="services-list-container">
										@viewsServices.ServicesTable(servicesList, true)
									</div>
								</div>
							</div>
						</div>
					} else {
						<div class="col-md-12">
							<div class="card shadow-sm">
								<div class="card-body">
									<h5 class="card-title mb-3">Configured Services</h5>
									@viewsServices.ServicesTable(servicesList, false)
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			<!-- Users Tab -->
			<div class="tab-pane fade" id="users" role="tabpanel" aria-labelledby="users-tab">
				<div class="row pt-3">
					if currentUser.UserRole == models.RoleAdmin {
						<!-- Invite User (Admins only) -->
						<div class="col-md-4">
							if inviteError != "" {
								<div class="alert alert-danger">{ inviteError }</div>
							}
							<div class="card shadow-sm mb-4">
								<div class="card-body">
									<h5 class="card-title mb-3">Invite User</h5>
									<form method="POST" action="/users/invite">
										<div class="mb-3">
											<label for="invite_email" class="form-label">Email address</label>
											<input type="email" class="form-control" id="invite_email" name="email" required placeholder="user@example.com"/>
										</div>
										<button type="submit" class="btn btn-success w-100">Send Invitation</button>
									</form>
								</div>
							</div>

							<div class="card shadow-sm">
								<div class="card-body">
									<h5 class="card-title mb-3">Pending Invitations</h5>
									@viewsUsers.InvitesTable(invites, true)
								</div>
							</div>
						</div>
						<div class="col-md-8">
							<div class="card shadow-sm">
								<div class="card-body">
									<h5 class="card-title mb-3">Registered Users</h5>
									@viewsUsers.UsersTable(usersList, currentUser.ID, true)
								</div>
							</div>
						</div>
					} else {
						<div class="col-md-12">
							<div class="card shadow-sm">
								<div class="card-body">
									<h5 class="card-title mb-3">Registered Users</h5>
									@viewsUsers.UsersTable(usersList, currentUser.ID, false)
								</div>
							</div>
						</div>
					}
				</div>
			</div>

			if currentUser.UserRole == models.RoleAdmin {
				<!-- System Logs Tab -->
				<div class="tab-pane fade" id="system-logs" role="tabpanel" aria-labelledby="system-logs-tab">
					<div class="row pt-3">
						<div class="col-md-12">
							<div class="card shadow-sm">
								<div class="card-body">
									<div class="d-flex justify-content-between align-items-center mb-3">
										<h5 class="card-title mb-0">System Application Logs (Live)</h5>
										<span class="badge bg-success" id="stream-status">Connected</span>
									</div>
									<div id="system-logs-container" class="p-3 bg-dark text-white rounded font-monospace" style="height: 500px; overflow-y: auto;">
										<pre id="system-logs-output" class="mb-0 text-white" style="white-space: pre-wrap; font-size: 13px;"></pre>
									</div>
								</div>
							</div>
						</div>
					</div>
					<script>
						document.addEventListener("DOMContentLoaded", function() {
							const logsOutput = document.getElementById("system-logs-output");
							const statusBadge = document.getElementById("stream-status");
							let eventSource;

							function connectLogsStream() {
								eventSource = new EventSource("/api/v1/admin/logs/stream");

								eventSource.onopen = function() {
									statusBadge.textContent = "Connected";
									statusBadge.className = "badge bg-success";
								};

								eventSource.onmessage = function(event) {
									try {
										const log = JSON.parse(event.data);
										const timestamp = log.time ? new Date(log.time).toISOString() : new Date().toISOString();
										const level = log.level ? log.level.toUpperCase() : "INFO";
										const message = log.message || "";
										
										let fieldsStr = "";
										if (log.fields && Object.keys(log.fields).length > 0) {
											fieldsStr = " " + JSON.stringify(log.fields);
										}
										
										let colorClass = "text-info";
										if (level === "WARN") colorClass = "text-warning";
										if (level === "ERROR") colorClass = "text-danger";
										
										const logLine = `[${timestamp}] <span class="${colorClass}">${level}</span>: ${message}${fieldsStr}\n`;
										logsOutput.innerHTML += logLine;
										
										const container = document.getElementById("system-logs-container");
										container.scrollTop = container.scrollHeight;
									} catch (e) {
										logsOutput.innerHTML += event.data + "\n";
									}
								};

								eventSource.onerror = function() {
									statusBadge.textContent = "Disconnected (Reconnecting...)";
									statusBadge.className = "badge bg-danger";
									eventSource.close();
									setTimeout(connectLogsStream, 3000);
								};
							}

							const tabEl = document.getElementById('system-logs-tab');
							if (tabEl) {
								tabEl.addEventListener('shown.bs.tab', function () {
									if (!eventSource) {
										connectLogsStream();
									}
								});
							}
						});
					</script>
				</div>
			}
		</div>

		<!-- Github Connect Modal -->
		if currentUser.UserRole == models.RoleAdmin {
			@viewsServices.GithubConnectModal(githubAuthURL)
		}
		<script>
			document.addEventListener("DOMContentLoaded", function() {
				var hash = window.location.hash;
				if (hash) {
					var tabElement = document.querySelector('button[data-bs-target="' + hash + '"]');
					if (tabElement) {
						var tab = new bootstrap.Tab(tabElement);
						tab.show();
					}
				}

				// Update URL hash when a tab changes
				var tabEls = document.querySelectorAll('button[data-bs-toggle="tab"]');
				tabEls.forEach(function(el) {
					el.addEventListener('shown.bs.tab', function(e) {
						var target = e.target.getAttribute("data-bs-target");
						if (history.replaceState) {
							history.replaceState(null, null, target);
						} else {
							location.hash = target;
						}
					});
				});
			});
		</script>
	}
}
