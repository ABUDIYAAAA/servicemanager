package users

import (
	"fmt"
	"servicemanager/internal/models"
)

templ UsersTable(users []models.User, currentUserID int, isAdmin bool) {
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>ID</th>
					<th>Email</th>
					<th>Role</th>
					if isAdmin {
						<th>Actions</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, u := range users {
					<tr>
						<td>{ fmt.Sprintf("%d", u.ID) }</td>
						<td>{ u.Email }</td>
						<td>
							if isAdmin && u.ID != currentUserID {
								<form hx-patch={ fmt.Sprintf("/api/v1/users/%d/role", u.ID) } hx-swap="none" class="d-inline-block">
									<select name="role" class="form-select form-select-sm" onchange="this.form.dispatchEvent(new Event('submit'))">
										<option value="admin" selected?={ u.UserRole == models.RoleAdmin }>Admin</option>
										<option value="user" selected?={ u.UserRole == models.RoleUser }>User</option>
									</select>
								</form>
							} else {
								<span class="badge bg-secondary">{ string(u.UserRole) }</span>
							}
						</td>
						if isAdmin {
							<td>
								if u.ID != currentUserID {
									<button class="btn btn-danger btn-sm"
											hx-delete={ fmt.Sprintf("/api/v1/users/%d", u.ID) }
											hx-target="closest tr"
											hx-swap="delete"
											hx-confirm="Are you sure you want to delete this user?">
										Delete
									</button>
								} else {
									<span class="text-muted">Current User</span>
								}
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ InvitesTable(invites []models.Invite, isAdmin bool) {
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>ID</th>
					<th>Email</th>
					if isAdmin {
						<th>Actions</th>
					}
				</tr>
			</thead>
			<tbody>
				if len(invites) == 0 {
					<tr>
						<td colspan="4" class="text-center text-muted">No pending invites</td>
					</tr>
				}
				for _, inv := range invites {
					<tr>
						<td>{ fmt.Sprintf("%d", inv.ID) }</td>
						<td>{ inv.Email }</td>
						if isAdmin {
							<td>
								<button class="btn btn-warning btn-sm"
										hx-delete={ fmt.Sprintf("/api/v1/users/invite/%s", inv.Token) }
										hx-target="closest tr"
										hx-swap="delete"
										hx-confirm="Are you sure you want to revoke this invitation?">
									Revoke
								</button>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}
