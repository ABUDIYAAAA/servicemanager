package services

import (
	"encoding/json"
	"fmt"
	"servicemanager/internal/models"
	"servicemanager/internal/views/layouts"
)

func getEnvVarsJSON(m map[string]string) string {
	if m == nil {
		return "{}"
	}
	bytes, err := json.Marshal(m)
	if err != nil {
		return "{}"
	}
	return string(bytes)
}

templ Deploy(s models.Service, err string) {
	@layouts.Layout("Deploy Service") {
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card shadow-sm my-5">
					<div class="card-body">
						<h3 class="card-title text-center mb-4">Deploy Service: { s.Name }</h3>
						if err != "" {
							<div class="alert alert-danger" role="alert">
								{ err }
							</div>
						}
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/services/%d/deploy", s.ID)) }>
							<!-- Commands Section -->
							<div class="card bg-light mb-4">
								<div class="card-body">
									<h5 class="card-title h6 mb-3 text-uppercase text-muted">Build & Runtime Config</h5>
									<div class="row">
										<div class="col-md-6 mb-3">
											<label for="build_command" class="form-label">Build Command</label>
											<input type="text" class="form-control" id="build_command" name="build_command" 
												value={ s.BuildCommand } placeholder="e.g. npm run build, go build, or empty" />
											<div class="form-text">Command to compile or build the service.</div>
										</div>
										<div class="col-md-6 mb-3">
											<label for="run_command" class="form-label">Run Command</label>
											<input type="text" class="form-control" id="run_command" name="run_command" required
												value={ s.RunCommand } placeholder="e.g. npm start, ./main" />
											<div class="form-text">Command to start the web server.</div>
										</div>
									</div>
									<div class="row">
										<div class="col-md-6 mb-3">
											<label for="port" class="form-label">Port</label>
											<input type="number" class="form-control" id="port" name="port" required
												value={ fmt.Sprintf("%d", s.Port) } placeholder="e.g. 8080" min="1" max="65535" />
											<div class="form-text">Network port the web server listens on.</div>
										</div>
									</div>
								</div>
							</div>


							<!-- Environment Variables (with JS parser) -->
							<div class="card bg-light mb-4">
								<div class="card-body">
									<h5 class="card-title h6 mb-3 text-uppercase text-muted d-flex justify-content-between align-items-center">
										Environment Variables
										<button type="button" class="btn btn-sm btn-outline-primary" onclick="addEnvRow('', '')">+ Add Variable</button>
									</h5>
									
									<div class="row g-2 mb-3 bg-white p-3 border rounded shadow-xs mx-0">
										<div class="col-sm-8">
											<textarea id="env-paste" class="form-control form-control-sm" rows="3" placeholder="Paste .env block here (e.g. KEY=VALUE)"></textarea>
										</div>
										<div class="col-sm-4 d-flex flex-column justify-content-between">
											<button type="button" class="btn btn-sm btn-secondary w-100" onclick="parsePastedEnv()">Parse Paste</button>
											<input type="file" id="env-file" class="d-none" onchange="uploadEnvFile(this)" accept=".env,text/plain"/>
											<button type="button" class="btn btn-sm btn-outline-secondary w-100 mt-2" onclick="document.getElementById('env-file').click()">Upload File</button>
										</div>
									</div>

									<div id="env-vars-rows">
										<!-- Dynamic env variables are populated here -->
									</div>
								</div>
							</div>

							<div class="d-flex justify-content-between mt-4">
								<a href="/" class="btn btn-outline-secondary">Cancel</a>
								<button type="submit" class="btn btn-primary btn-lg">Save & Deploy</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>

		<!-- Script to handle dynamic fields and parsing -->
		<script>
			function addEnvRow(key, val) {
				const container = document.getElementById('env-vars-rows');
				const rowId = 'row-' + Date.now() + '-' + Math.floor(Math.random()*1000);
				
				const rowDiv = document.createElement('div');
				rowDiv.className = 'row g-2 mb-2 align-items-center';
				rowDiv.id = rowId;
				rowDiv.innerHTML = `
					<div class="col-5">
						<input type="text" name="env_keys[]" class="form-control form-control-sm" value="${key}" placeholder="KEY" required />
					</div>
					<div class="col-5">
						<input type="text" name="env_vals[]" class="form-control form-control-sm" value="${val}" placeholder="VALUE" required />
					</div>
					<div class="col-2 text-end">
						<button type="button" class="btn btn-sm btn-danger w-100" onclick="document.getElementById('${rowId}').remove()">Remove</button>
					</div>
				`;
				container.appendChild(rowDiv);
			}

			function processEnvText(text) {
				const lines = text.split('\n');
				for (let line of lines) {
					line = line.trim();
					if (!line || line.startsWith('#')) continue;
					const parts = line.split('=');
					if (parts.length >= 2) {
						const key = parts[0].trim();
						let val = parts.slice(1).join('=').trim();
						// strip quotes
						if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
							val = val.slice(1, -1);
						}
						addEnvRow(key, val);
					}
				}
			}

			function parsePastedEnv() {
				const textarea = document.getElementById('env-paste');
				const text = textarea.value;
				if (text.trim() === '') return;
				processEnvText(text);
				textarea.value = '';
			}

			function uploadEnvFile(input) {
				const file = input.files[0];
				if (!file) return;
				const reader = new FileReader();
				reader.onload = function(e) {
					processEnvText(e.target.result);
				};
				reader.readAsText(file);
				input.value = '';
			}

			// Render existing variables on load
			document.addEventListener('DOMContentLoaded', function() {
				const initialVars = JSON.parse( { getEnvVarsJSON(s.EnvVars) } );
				for (const [key, val] of Object.entries(initialVars)) {
					addEnvRow(key, val);
				}
			});
		</script>
	}
}
