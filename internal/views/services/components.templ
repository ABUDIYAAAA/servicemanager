package services

import (
	"fmt"
	"servicemanager/internal/models"
)

templ ServicesTable(services []models.Service, isAdmin bool) {
	<div class="table-responsive">
		<table class="table table-striped align-middle">
			<thead>
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Description</th>
					<th>GitHub Repo</th>
					<th>Status</th>
					if isAdmin {
						<th>Actions</th>
					}
				</tr>
			</thead>
			<tbody>
				if len(services) == 0 {
					<tr>
						<td colspan="6" class="text-center text-muted">No services configured</td>
					</tr>
				}
				for _, s := range services {
					<tr>
						<td>{ fmt.Sprintf("%d", s.ID) }</td>
						<td><a href={ templ.SafeURL(fmt.Sprintf("/services/%d", s.ID)) }><strong>{ s.Name }</strong></a></td>
						<td>{ s.Description }</td>
						<td>
							if s.GithubRepoName != "" {
								<span class="badge bg-info text-dark">{ s.GithubRepoName }</span>
							} else {
								<span class="text-muted">-</span>
							}
						</td>
						<td>
							if s.Status == "draft" {
								<span class="badge bg-warning text-dark">draft</span>
							} else if s.Status == "deploying" {
								<span class="badge bg-primary">deploying</span>
							} else {
								<span class="badge bg-success">{ s.Status }</span>
							}
						</td>
						if isAdmin {
							<td>
								<a href={ templ.SafeURL(fmt.Sprintf("/services/%d/deploy", s.ID)) } class="btn btn-sm btn-primary me-2">
									Deploy
								</a>
								<button class="btn btn-danger btn-sm"
										hx-delete={ fmt.Sprintf("/api/v1/services/%d", s.ID) }
										hx-target="closest tr"
										hx-swap="delete"
										hx-confirm="Are you sure you want to delete this service?">
									Delete
								</button>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ AddServiceForm(githubRepos []models.GithubRepo, githubInstalled bool, githubAuthURL string) {
	<div class="card shadow-sm mb-4">
		<div class="card-body">
			<h5 class="card-title mb-3">Add Service</h5>
			
			if githubInstalled {
				<form method="POST" action="/services/add">
					<div class="mb-3">
						<label for="name" class="form-label">Service Name</label>
						<input type="text" class="form-control" id="name" name="name" required placeholder="e.g. Auth Service"/>
					</div>
					<div class="mb-3">
						<label for="description" class="form-label">Description</label>
						<textarea class="form-control" id="description" name="description" placeholder="e.g. Manages user sessions"></textarea>
					</div>
					<div class="mb-3">
						<label for="github_repo_name" class="form-label">GitHub Repository</label>
						<select class="form-select" id="github_repo_name" name="github_repo_name">
							<option value="">-- Select GitHub Repository (Optional) --</option>
							for _, repo := range githubRepos {
								<option value={ repo.FullName }>{ repo.FullName }</option>
							}
						</select>
					</div>
					<button type="submit" class="btn btn-primary">Add Service</button>
				</form>
			} else {
				<div class="p-3 bg-light border rounded text-center">
					<p class="mb-2 text-muted">To add a service, you must first connect your GitHub account.</p>
					<button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#githubConnectModal">
						Add Service
					</button>
				</div>
			}
		</div>
	</div>
}

templ GithubConnectModal(githubAuthURL string) {
	<div class="modal fade" id="githubConnectModal" tabindex="-1" aria-labelledby="githubConnectModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="githubConnectModalLabel">GitHub Connection Required</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<p>You must connect your GitHub account via our GitHub App to add a service.</p>
					<p class="text-muted small">This will redirect you to GitHub where you can authorize the app on your repository or organization.</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
					<a href={ templ.SafeURL(githubAuthURL) } target="_blank" class="btn btn-primary" onclick="var m = bootstrap.Modal.getInstance(document.getElementById('githubConnectModal')); if(m) m.hide();">
						Connect GitHub
					</a>
				</div>
			</div>
		</div>
	</div>
}
